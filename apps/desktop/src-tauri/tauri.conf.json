{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* https://localhost:*; img-src 'self' data: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "trayIcon": {
      "icon": "icons/icon.png",
      "title": "Maturidi Academy",
      "tooltip": "Maturidi Academy"
    },
    "windows": [
      {
        "decorations": true,
        "height": 800,
        "label": "main",
        "minHeight": 600,
        "minWidth": 960,
        "resizable": true,
        "title": "Maturidi Academy",
        "width": 1280
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../shell"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": null
    },
    "targets": "all",
    "windows": {
      "certificateThumbprint": "",
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "identifier": "academy.maturidi.desktop",
  "plugins": {
    "notification": {}
  },
  "productName": "Maturidi Academy",
  "version": "0.1.0"
  // FIX3-01: هیچ بلوک top-level «updater»ای در این فایل نیست و نباید
  // برگردد — «updater» در سطح بالا سبک Tauri v1 است و اسکیمای v2 کل
  // کانفیگ را رد می‌کند (خطای ران واقعی Desktop builds #5 مالک:
  // «Additional properties are not allowed ('updater' was
  // unexpected)»). نیت C-05 (ADR-0031) سر جایش است: آپدیتر تا وقتی
  // زیرساخت releases واقعی + کلید امضا آماده شود غیرفعال می‌ماند —
  // در Tauri 2 «غیرفعال» یعنی بلوک **غایب** باشد؛ فعال‌سازی فقط با
  // افزودن plugins.updater (فرم v2) با endpoint و pubkey واقعی و
  // تصمیم ثبت‌شده در ADR-0031. چک‌لیست انتشار: apps/desktop/README.md
}
