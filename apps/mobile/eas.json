{
  "build": {
    "development": {
      "android": {
        "buildType": "apk"
      },
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENVIRONMENT": "development"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "APP_ENVIRONMENT": "preview",
        "EXPO_PUBLIC_API_URL": "https://maturidi-academy-production.up.railway.app"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENVIRONMENT": "production",
        "EXPO_PUBLIC_API_URL": "https://maturidi-academy-production.up.railway.app"
      }
    },
    "production-apk": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "APP_ENVIRONMENT": "production"
      }
    }
  },
  "cli": {
    "appVersionSource": "local",
    "version": ">= 13.0.0"
  },
  "submit": {
    "production": {}
  }
}