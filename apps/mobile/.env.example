# ── آکادمی ماتریدی — mobile .env.example ──────────────────────────────
# Copy to .env and fill in. NEVER commit real secrets or google-services.json.

# Base URL of the FastAPI backend (no trailing slash).
# Dev: your machine's LAN IP so a physical device/emulator can reach it,
# e.g. http://192.168.1.50:8000  (the Android emulator can also use
# http://10.0.2.2:8000).
EXPO_PUBLIC_API_URL=http://localhost:8000

# EAS project id (expo.dev). Required for Expo Push tokens (FCM under the
# hood). Leave empty to run without push registration; the app logs a
# warning and continues.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional override for the push-token registration endpoint (Phase-13
# server contract). Default: /api/v1/users/me/devices
# EXPO_PUBLIC_PUSH_REGISTER_PATH=/api/v1/users/me/devices
