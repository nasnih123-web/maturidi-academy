{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#064e3b",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "org.maturidi.academy",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 1
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "defaultLocale": "fa",
      "easProjectId": "808c8ff1-d7c6-41e8-9599-2569c6a6f7cb",
      "eas": {
        "projectId": "808c8ff1-d7c6-41e8-9599-2569c6a6f7cb"
      },
      "supportsRTL": true
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "org.maturidi.academy",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "fa",
        "CFBundleLocalizations": [
          "fa",
          "ar",
          "en"
        ]
      },
      "supportsTablet": true
    },
    "name": "آکادمی ماتریدی",
    "owner": "nasnihs-team",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#047857",
          "icon": "./assets/notification-icon.png",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#064e3b"
        }
      ]
    ],
    "scheme": "maturidi-academy",
    "slug": "maturidi-academy",
    "userInterfaceStyle": "automatic",
    "version": "1.0.0"
  }
}
