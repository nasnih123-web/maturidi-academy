# Copy to `.env` (not committed) and adjust as needed.
# Base URL of the Maturidi Academy API used for server-side fetches.
API_URL=http://localhost:8000

# Public base URL of the FastAPI backend (no trailing slash) — used by
# client-side code (lib/social.ts and others).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site URL — used for sitemap.xml / robots.txt absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Screenshot-only switch: when =1, lib/social.ts serves fixture data from
# lib/demo-social.ts instead of the live API (OFF by default; §15.9).
# NEVER enable in production.
NEXT_PUBLIC_SOCIAL_DEMO=
