# nginx جلوی next start — پاسخ upstream را کامل بافر می‌کند و با Content-Length می‌فرستد.
# __PORT__ در start.sh با $PORT تزریقی Railway جایگزین می‌شود.
# کانتینر همین حالا به‌عنوان root اجرا می‌شود، پس worker هم root است تا به
# لاگ و tmp بدون دردسر دسترسی داشته باشد.
user root;
worker_processes 1;
pid /run/nginx/nginx.pid;
error_log /var/log/nginx/error.log warn;
events {
    worker_connections 1024;
}
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    sendfile on;
    # عمداً gzip خاموش: تا طول بافرشده حفظ شود و downstream با Content-Length
    # بیاید، نه chunked فشرده‌شده.
    gzip off;
    # chunked را کلا خاموش کن: حتی اگر upstream chunked فرستاد، nginx باید
    # پاسخ را کامل بافر کند و با Content-Length بفرستد، نه اینکه chunked را
    # به پایین‌دست منتقل کند. بدون این خط، بافرینگ به‌تنهایی کافی نبود
    # (دیپلوی 28bd057d با وجود nginx فعال، هنوز chunked می‌داد).
    chunked_transfer_encoding off;
    # سربرگ اثبات: تا در بررسی سربرگ معلوم شود nginx واقعاً در مسیر است.
    add_header X-Web-Proxy "nginx" always;
    proxy_buffering on;
    proxy_buffer_size 16k;
    proxy_buffers 16 16k;
    proxy_busy_buffers_size 32k;
    proxy_temp_path /var/lib/nginx/tmp;
    server {
        listen __PORT__;
        server_name _;
        location / {
            proxy_pass http://127.0.0.1:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_connect_timeout 10s;
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;
        }
    }
}
