# ===== آکادمی ماتریدی — نمونهٔ متغیرهای production =====
# استفاده:  cp .env.prod.example .env.prod   (سپس مقادیر واقعی را پر کنید)
# هرگز .env.prod را کامیت نکنید — از secrets manager هم می‌توانید تزریق کنید.
# همهٔ متغیرهای :? در docker-compose.prod.yml اجباری‌اند؛ بدون آن‌ها
# `docker compose config` خطا می‌دهد (fail-fast قبل از استقرار).

APP_ENV=production

# --- Postgres (سرویس postgres) ---
POSTGRES_USER=maturidi
POSTGRES_PASSWORD=__PUT_A_STRONG_PASSWORD_HERE__
POSTGRES_DB=maturidi

# --- Redis (سرویس redis) ---
REDIS_PASSWORD=__PUT_A_STRONG_PASSWORD_HERE__

# --- محدودیت نرخ (§۷) ---
# در production قطع Redis یعنی 429 روی endpointهای احرازهویتی (fail-closed عمدی).
# فقط اگر می‌دانید چه می‌کنید: RATE_LIMIT_FAIL_CLOSED=false
RATE_LIMIT_FAIL_CLOSED=true
# فاصلهٔ پروبِ بهبودی Redis پس از قطع (ثانیه)
RATE_LIMIT_REDIS_RETRY_S=30
# IP پروکسی/لودبالانسر جلوی API (برای پذیرش X-Forwarded-For) — در compose
# داخلی معمولاً لازم نیست؛ پشت Cloudflare/LB مقداردهی شود
TRUSTED_PROXIES=

# --- MinIO (سرویس minio) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=__PUT_A_STRONG_PASSWORD_HERE__

# --- API (سرویس api و worker-*) ---
# درون شبکهٔ compose، هاست‌ها نام سرویس‌اند (نه localhost).
# نکته: مقادیر این فایل literal هستند (interpolate نمی‌شوند) — پس رمزها را
# در هر سه‌جا (POSTGRES_PASSWORD/REDIS_PASSWORD/MINIO_ROOT_PASSWORD و این‌جا)
# یکسان وارد کنید.
DATABASE_URL=postgresql+asyncpg://maturidi:__SAME_AS_POSTGRES_PASSWORD__@postgres:5432/maturidi
REDIS_URL=redis://:__SAME_AS_REDIS_PASSWORD__@redis:6379/0
S3_ENDPOINT=http://minio:9000
# آدرس عمومی MinIO برای presigned URLهای مرورگر — باید از بیرون شبکهٔ داکر
# قابل دسترس باشد (مثلاً https://files.example.com). اگر خالی بماند، همان
# S3_ENDPOINT استفاده می‌شود؛ در production با هاست داخلی (minio/localhost)
# بوت فیل می‌شود تا آدرس داخلی به مرورگر نشت نکند.
S3_ENDPOINT_PUBLIC=
S3_ACCESS_KEY=__SAME_AS_MINIO_ROOT_USER__
S3_SECRET_KEY=__SAME_AS_MINIO_ROOT_PASSWORD__
S3_BUCKET=maturidi-media
S3_REGION=us-east-1
# کدام پیاده‌سازی StorageProvider (§۶): در production حتماً s3 (MinIO همین compose)
STORAGE_PROVIDER=s3
STORAGE_LOCAL_DIR=/code/storage
# آدرس عمومی API — در callbackهای پرداخت و لینک‌های ایمیل استفاده می‌شود
APP_BASE_URL=https://api.example.com

# --- امنیت (فاز ۰ §۳ — هیچ‌کدام نباید CHANGE_ME یا خالی بمانند) ---
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=__PUT_A_RANDOM_SECRET_HERE__
ENCRYPTION_KEY=__PUT_A_RANDOM_32_BYTE_KEY_HERE__
ENCRYPTION_KEY_VERSION=1
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- CORS: دامنه‌های فرانت، کاما-جدا (خالی = غیرفعال) ---
CORS_ALLOW_ORIGINS=https://example.com,https://crm.example.com

# --- uvicorn ---
UVICORN_WORKERS=4

# --- رصدپذیری ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_FORMAT=json

# --- Web (سرویس web — آدرس عمومی API برای بیلد Next.js) ---
WEB_API_URL=https://api.example.com

# --- CRM (سرویس crm — آدرس عمومی API برای باندل Vite؛ اجباری، بدون fallback) ---
CRM_API_URL=https://api.example.com

# --- Grafana (سرویس grafana) ---
GRAFANA_PASSWORD=__PUT_A_STRONG_PASSWORD_HERE__

# --- Metabase BI (سرویس‌های metabase-db و metabase) ---
MB_APP_DB_USER=metabase
MB_APP_DB_PASS=__PUT_A_STRONG_PASSWORD_HERE__
MB_APP_DBNAME=metabaseapp
MB_SITE_URL=https://bi.example.com
