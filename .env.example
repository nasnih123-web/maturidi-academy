# ===== آکادمی ماتریدی — نمونهٔ متغیرهای محیطی =====
# این فایل را کپی کن به .env و مقادیر واقعی را بگذار. هرگز .env را کامیت نکن.

APP_ENV=dev   # dev | staging | production

# --- دیتابیس ---
# حالت Docker (پیش‌فرض production/staging):
DATABASE_URL=postgresql+asyncpg://maturidi:maturidi@localhost:5432/maturidi
# حالت سبک بدون Docker (dev روی همین ماشین):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- امنیت (فاز ۰ §۲ و §۳) ---
# کلید رمزنگاری مقادیر حساس platform_settings — از secrets manager/env جدا تزریق شود،
# هرگز در ریپو یا دیتابیس نگه‌داری نشود. برای تولید با یک مقدار تصادفی ۳۲ بایتی عوض شود:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=CHANGE_ME__generate_a_random_32_byte_key
ENCRYPTION_KEY_VERSION=1
JWT_SECRET=CHANGE_ME__generate_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- ذخیرهٔ فایل (MinIO / S3-سازگار) — فاز ۰ §۶ ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=maturidi-media
S3_REGION=us-east-1

# --- ایمیل تراکنشی (فاز ۱) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- پیامک (Kavenegar/Ghasedak) — فاز ۱ ---
SMS_PROVIDER=
SMS_API_KEY=

# --- AI (فاز ۶ به بعد؛ کلید از صفحهٔ تنظیمات CRM هم قابل ورود است) ---
ANTHROPIC_API_KEY=
AI_FALLBACK_MODEL=

# --- AI فاز ۶: embedding خارجی (اختیاری؛ پیش‌فرض provider داخلی hash است) ---
AI_EMBEDDING_ENDPOINT=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# --- رصدپذیری (فاز ۲) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_FORMAT=text   # text | json — حالت json برای Loki

# --- بلادرنگ (فاز ۲) ---
DISPATCHER_POLL_INTERVAL=1.0   # ثانیه — فاصلهٔ polling جدول domain_events
WS_HEARTBEAT_INTERVAL=25       # ثانیه — ping/pong دوره‌ای WebSocket
WS_HEARTBEAT_TIMEOUT=60        # ثانیه — قطع اتصال بعد از بی‌پاسخی
