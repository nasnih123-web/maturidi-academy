# ===== آکادمی ماتریدی — نمونهٔ متغیرهای محیطی =====
# این فایل را کپی کن به .env و مقادیر واقعی را بگذار. هرگز .env را کامیت نکن.

APP_ENV=dev   # dev | staging | production
APP_NAME=Maturidi Academy API
APP_BASE_URL=http://localhost:8000   # آدرس عمومی API (لینک‌های ایمیل/سئو/وِبهوک)

# --- دیتابیس ---
# حالت Docker (پیش‌فرض production/staging):
DATABASE_URL=postgresql+asyncpg://maturidi:maturidi@localhost:5432/maturidi
# حالت سبک بدون Docker (dev روی همین ماشین):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- Redis ---
# اجرای محلی: localhost — درون docker-compose سرویس api به‌صورت خودکار
# redis://redis:6379/0 را override می‌کند (environment در docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
# production: رمز Redis (در docker-compose.prod.yml اجباری است)
REDIS_PASSWORD=

# --- محدودیت نرخ توزیع‌شده (remediation-pass-2 Track 1 §۷) ---
# endpointهای حساس (login/register/بازیابی/2FA) روی Redis محدود می‌شوند (اتمیک).
# اگر Redis در production در دسترس نباشد، endpointهای احرازهویتی fail-closed
# می‌شوند (429) تا نبودِ Redis به‌معنای باز بودن در نباشد؛ در dev/test
# fallback حافظه‌ای. این رفتار عمدی و مستند است — برای غیرفعال‌کردن در
# production (توصیه نمی‌شود): RATE_LIMIT_FAIL_CLOSED=false
RATE_LIMIT_FAIL_CLOSED=true
# پس از قطع Redis، هر چند ثانیه یک‌بار اتصال پروب می‌شود تا شمارش معتبر
# برگردد (نه stuck-open، نه stuck-closed) — final remediation Track 2
RATE_LIMIT_REDIS_RETRY_S=30
# IPهای پروکسی مورداعتماد (کاما-جدا) که X-Forwarded-Forشان پذیرفته می‌شود؛
# خالی = هدر XFF همیشه نادیده گرفته می‌شود (پیش‌فرض امن در برابر جعل)
TRUSTED_PROXIES=

# --- امنیت (فاز ۰ §۲ و §۳) ---
# کلید رمزنگاری مقادیر حساس platform_settings — از secrets manager/env جدا تزریق شود،
# هرگز در ریپو یا دیتابیس نگه‌داری نشود. برای تولید با یک مقدار تصادفی ۳۲ بایتی عوض شود:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=CHANGE_ME__generate_a_random_32_byte_key
ENCRYPTION_KEY_VERSION=1
JWT_SECRET=CHANGE_ME__generate_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- ذخیرهٔ فایل (MinIO / S3-سازگار) — فاز ۰ §۶ ---
# اجرای محلی: localhost — درون docker-compose سرویس api به‌صورت خودکار
# http://minio:9000 را override می‌کند
# STORAGE_PROVIDER: کدام پیاده‌سازی StorageProvider استفاده شود —
#   local (پیش‌فرض dev — فایل‌ها در STORAGE_LOCAL_DIR) | s3 (MinIO/S3 با مقادیر زیر)
# در production باید s3 باشد (نمونه: .env.prod.example).
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
# آدرس عمومی برای presigned URLهای مرورگر (پیش‌فرض: همان S3_ENDPOINT)
S3_ENDPOINT_PUBLIC=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=maturidi-media
S3_REGION=us-east-1
# فاز ۸ — دایرکتوری محلی StorageProvider پیش‌فرض
STORAGE_LOCAL_DIR=./storage

# --- CORS (فاز ۲) ---
# خالی = غیرفعال؛ کاما-جدا یا "*" (مثلاً برای تست موقت یا فرانت جدا)
CORS_ALLOW_ORIGINS=

# --- ایمیل تراکنشی (فاز ۱) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- پیامک (Kavenegar/Ghasedak) — فاز ۱ ---
SMS_PROVIDER=
SMS_API_KEY=

# --- AI (فاز ۶ به بعد؛ کلید از صفحهٔ تنظیمات CRM هم قابل ورود است) ---
ANTHROPIC_API_KEY=
AI_FALLBACK_MODEL=

# --- AI فاز ۶: embedding خارجی (اختیاری؛ پیش‌فرض provider داخلی hash است) ---
AI_EMBEDDING_ENDPOINT=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# --- رصدپذیری (فاز ۲) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_FORMAT=text   # text | json — حالت json برای Loki

# --- بلادرنگ (فاز ۲) ---
DISPATCHER_POLL_INTERVAL=1.0   # ثانیه — فاصلهٔ polling جدول domain_events
WS_HEARTBEAT_INTERVAL=25       # ثانیه — ping/pong دوره‌ای WebSocket
WS_HEARTBEAT_TIMEOUT=60        # ثانیه — قطع اتصال بعد از بی‌پاسخی

# --- مانیتورینگ dev (docker-compose.yml) ---
GRAFANA_PASSWORD=admin

# --- production (docker-compose.prod.yml) ---
# تعداد workerهای uvicorn در production (پیش‌فرض compose: ۴)
UVICORN_WORKERS=4

# --- تلگرام دوطرفه (فاز ۱۱) ---
# توکن بات و api_id/api_hash از «تنظیمات پلتفرم» در CRM وارد می‌شوند (نه از env)؛
# نام کلیدهای platform_settings (مقادیر این‌جا همیشه خالی می‌مانند):
#   telegram.enabled            — فعال/غیرفعال بودن بات (true/false)
#   telegram.bot_token           — توکن بات (secret، رمزنگاری‌شده با ENCRYPTION_KEY)
#   telegram.webhook_secret      — رمز وبهوک (هدر X-Telegram-Bot-Api-Secret-Token)
#   telegram.channel             — کانال پیش‌فرض (مثلاً @madrasto_al_emamo_al_matoridi)
#   telegram.api_id / telegram.api_hash — برای اتصال حساب Telethon از CRM (secret)
#   telegram.session             — session رمزنگاری‌شدهٔ Telethon (خودکار، secret)
#   telegram.phone_masked        — شمارهٔ ماسک‌شده (فقط نمایشی)
