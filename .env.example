# ===== آکادمی ماتریدی — نمونهٔ متغیرهای محیطی =====
# این فایل را کپی کن به .env و مقادیر واقعی را بگذار. هرگز .env را کامیت نکن.
# نکته (FIX2-06): برای توسعهٔ محلیِ بدون Docker، bootstrap خودش فایل
# .env مخصوص dev را با tools/dev/write_dev_env.py می‌سازد (کپچا خاموش
# و بای‌پس فقط-dev ClamAV، صریح و مستند) — این قالب برای
# staging/production است، نه اجرای محلی.

APP_ENV=dev   # dev | staging | production
APP_NAME=Maturidi Academy API
APP_BASE_URL=http://localhost:8000   # آدرس عمومی API (لینک‌های ایمیل/سئو/وِبهوک)

# --- دیتابیس ---
# حالت Docker (پیش‌فرض production/staging):
DATABASE_URL=postgresql+asyncpg://maturidi:maturidi@localhost:5432/maturidi
# حالت سبک بدون Docker (dev روی همین ماشین):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# --- Redis ---
# اجرای محلی: localhost — درون docker-compose سرویس api به‌صورت خودکار
# redis://redis:6379/0 را override می‌کند (environment در docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# --- اسکن ویروس آپلودها: ClamAV (C-01 — ADR-0028، قرارداد §۷) ---
# سیاست fail-closed در همهٔ محیط‌ها: اگر clamd در دسترس نباشد، آپلود
# رد می‌شود (503 antivirus_unavailable) — هرگز ردِّ بی‌صدا نداریم.
# در compose نام سرویس clamav است؛ برای اجرای محلیِ بدون compose،
# clamd را روی localhost اجرا و CLAMAV_HOST=localhost بگذارید.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
# بای‌پس ناامنِ فقط-dev (پیش‌فرض خاموش): فقط با APP_ENV=dev اثر دارد و
# هر فراخوانی‌اش CRITICAL لاگ می‌شود؛ در production بی‌اثر است. هرگز
# در استقرار واقعی روشن نکنید.
CLAMAV_ALLOW_INSECURE_DEV_BYPASS=false

# --- کپچای ثبت‌نام: Cloudflare Turnstile (C-02 — ADR-0029) ---
# پیش‌فرض: فعال. اگر SECRET خالی باشد ثبت‌نام fail-closed با 503
# captcha_not_configured رد می‌شود؛ برای dev محلی یا SECRET بگذارید
# یا صریحاً CAPTCHA_ENABLED=false کنید. SITE_KEY عمومی است و از
# /api/v1/settings/public به وب/موبایل می‌رسد؛ SECRET هرگز فاش نمی‌شود.
CAPTCHA_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# production: رمز Redis (در docker-compose.prod.yml اجباری است)
REDIS_PASSWORD=

# --- محدودیت نرخ توزیع‌شده (remediation-pass-2 Track 1 §۷) ---
# endpointهای حساس (login/register/بازیابی/2FA) روی Redis محدود می‌شوند (اتمیک).
# اگر Redis در production در دسترس نباشد، endpointهای احرازهویتی fail-closed
# می‌شوند (429) تا نبودِ Redis به‌معنای باز بودن در نباشد؛ در dev/test
# fallback حافظه‌ای. این رفتار عمدی و مستند است — برای غیرفعال‌کردن در
# production (توصیه نمی‌شود): RATE_LIMIT_FAIL_CLOSED=false
RATE_LIMIT_FAIL_CLOSED=true
# پس از قطع Redis، هر چند ثانیه یک‌بار اتصال پروب می‌شود تا شمارش معتبر
# برگردد (نه stuck-open، نه stuck-closed) — final remediation Track 2
RATE_LIMIT_REDIS_RETRY_S=30
# IPهای پروکسی مورداعتماد (کاما-جدا) که X-Forwarded-Forشان پذیرفته می‌شود؛
# خالی = هدر XFF همیشه نادیده گرفته می‌شود (پیش‌فرض امن در برابر جعل)
TRUSTED_PROXIES=

# --- امنیت (فاز ۰ §۲ و §۳) ---
# کلید رمزنگاری مقادیر حساس platform_settings — از secrets manager/env جدا تزریق شود،
# هرگز در ریپو یا دیتابیس نگه‌داری نشود. برای تولید با یک مقدار تصادفی ۳۲ بایتی عوض شود:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=CHANGE_ME__generate_a_random_32_byte_key
ENCRYPTION_KEY_VERSION=1
# چرخش کلید (M-05 — ADR-0036): برای rotate کردن، کلید تازه را در این
# JSON map بگذارید و ENCRYPTION_KEY_VERSION را بالا ببرید؛ مقادیر قدیمی
# با کلید نسخهٔ خودشان خوانا می‌مانند و با POST /api/v1/admin/settings/reencrypt
# تدریجاً به نسخهٔ جاری مهاجرت می‌کنند. مثال چرخش از ۱ به ۲:
#   ENCRYPTION_KEYS={"1": "<کلید قبلی>", "2": "<کلید تازه>"}
#   ENCRYPTION_KEY_VERSION=2
# وقتی reencrypt شمار «rotated» را صفر و همه را current گزارش کرد،
# کلید قدیمی را از map حذف کنید. خالی = فقط ENCRYPTION_KEY (رفتار قبل).
ENCRYPTION_KEYS=
JWT_SECRET=CHANGE_ME__generate_a_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
# راز اختصاصی امضای URLهای دانلود storage (FIX3-02 — ADR-0049) — جدا
# از JWT_SECRET تا نشت یکی، دیگری را نیندازد. در production/staging
# الزامی است (نبود/ضعف/برابری با JWT یا ENCRYPTION = fail-fast در
# بوت)، حداقل ۳۲ کاراکتر و کاملاً متفاوت از بقیهٔ رازها.
# چرخش بدون قطعی: مقدار تازه را در STORAGE_SIGNING_SECRET و مقدار
# فعلی را موقتاً در STORAGE_SIGNING_SECRET_PREVIOUS بگذارید؛ پس از
# گذشت حداکثر عمر URLها (دقایق) PREVIOUS را خالی کنید. ران‌بوک کامل:
# docs/ops/storage.md — در dev/test خالی یعنی fallback به JWT_SECRET.
STORAGE_SIGNING_SECRET=
STORAGE_SIGNING_SECRET_PREVIOUS=

# --- ذخیرهٔ فایل (MinIO / S3-سازگار) — فاز ۰ §۶ ---
# اجرای محلی: localhost — درون docker-compose سرویس api به‌صورت خودکار
# http://minio:9000 را override می‌کند
# STORAGE_PROVIDER: کدام پیاده‌سازی StorageProvider استفاده شود —
#   local (پیش‌فرض dev — فایل‌ها در STORAGE_LOCAL_DIR) | s3 (MinIO/S3 با مقادیر زیر)
# در production باید s3 باشد (نمونه: .env.prod.example).
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
# آدرس عمومی برای presigned URLهای مرورگر (پیش‌فرض: همان S3_ENDPOINT)
S3_ENDPOINT_PUBLIC=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=maturidi-media
S3_REGION=us-east-1
# فاز ۸ — دایرکتوری محلی StorageProvider پیش‌فرض
STORAGE_LOCAL_DIR=./storage

# --- CORS (فاز ۲) ---
# خالی = غیرفعال؛ کاما-جدا یا "*" (مثلاً برای تست موقت یا فرانت جدا)
CORS_ALLOW_ORIGINS=

# --- ایمیل تراکنشی (فاز ۱) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- پیامک (Kavenegar/Ghasedak) — فاز ۱ ---
SMS_PROVIDER=
SMS_API_KEY=

# --- AI (فاز ۶ به بعد؛ کلید از صفحهٔ تنظیمات CRM هم قابل ورود است) ---
ANTHROPIC_API_KEY=
AI_FALLBACK_MODEL=

# --- AI فاز ۶: embedding خارجی (اختیاری؛ پیش‌فرض provider داخلی hash است) ---
AI_EMBEDDING_ENDPOINT=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

# --- رصدپذیری (فاز ۲) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_FORMAT=text   # text | json — حالت json برای Loki

# --- بلادرنگ (فاز ۲) ---
DISPATCHER_POLL_INTERVAL=1.0   # ثانیه — فاصلهٔ polling جدول domain_events
WS_HEARTBEAT_INTERVAL=25       # ثانیه — ping/pong دوره‌ای WebSocket
WS_HEARTBEAT_TIMEOUT=60        # ثانیه — قطع اتصال بعد از بی‌پاسخی

# --- مرکز بیلدها: dispatch واقعی به GitHub Actions (F-05 remediation) ---
# هر دو خالی = ارائه‌دهندهٔ بیلد پیکربندی نشده است و POST /admin/builds/rebuild
# صادقانه 503 (build_provider_not_configured) می‌دهد؛ هیچ «queued» دروغینی
# ساخته نمی‌شود. توکن: fine-grained PAT با دسترسی Actions: Read/Write روی
# همان repo — هرگز در دیتابیس/audit ذخیره نمی‌شود. راهنما:
# docs/ops/APK_BUILD_GUIDE.md
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=

# --- مرکز بیلدها: callback انتشار از CI (B-01 — ADR-0025) ---
# توکن سرویس اختصاصی‌ای که workflowهای mobile/desktop با آن (هدر
# X-Build-Service-Token) انتشار ساخته‌شده را به POST /admin/builds/releases
# ثبت می‌کنند. خالی = مسیر سرویس غیرفعال (ثبت فقط با کاربرِ دارای مجوز).
# یک رشتهٔ تصادفی بلند بسازید و عیناً همین مقدار را در GitHub repo Secrets
# هم با نام BUILDS_SERVICE_TOKEN بگذارید. Secretهای سمت GitHub برای بستن
# حلقهٔ بیلد: BUILDS_API_BASE_URL (نشانی عمومی همین API)، BUILDS_SERVICE_TOKEN،
# BUILDS_S3_ENDPOINT / BUILDS_S3_BUCKET / BUILDS_S3_ACCESS_KEY /
# BUILDS_S3_SECRET_KEY (دسترسی نوشتن روی باکت builds در MinIO/S3).
# راهنمای کامل: docs/ops/APK_BUILD_GUIDE.md
BUILDS_SERVICE_TOKEN=

# --- مرکز بیلدها: باکت storage سمت API (FIX2-02 — ADR-0041) ---
# کالبک CI فایل‌ها را با Secretهای BUILDS_S3_* گیت‌هاب در باکت builds
# می‌نویسد؛ سمت API برای ساخت URL دانلود و prune باید دقیقاً همان باکت
# را بخواند. قرارداد «همه یا هیچ»: هر چهار مقدار اصلی یا با هم پر شوند
# (دقیقاً برابر مقادیر GitHub Secrets) یا هر چهار خالی بمانند — در این
# حالت بیلدها از همان باکت عمومی S3_BUCKET استفاده می‌کنند. تنظیم ناقص
# در startup با خطای واضح fail می‌شود، نه این‌که دانلود روی باکت اشتباه برود.
BUILDS_S3_ENDPOINT=
BUILDS_S3_ENDPOINT_PUBLIC=
BUILDS_S3_ACCESS_KEY=
BUILDS_S3_SECRET_KEY=
BUILDS_S3_BUCKET=
BUILDS_S3_REGION=us-east-1

# --- مانیتورینگ dev (docker-compose.yml) ---
GRAFANA_PASSWORD=admin

# --- production (docker-compose.prod.yml) ---
# تعداد workerهای uvicorn در production (پیش‌فرض compose: ۴)
UVICORN_WORKERS=4

# --- تلگرام دوطرفه (فاز ۱۱) ---
# توکن بات و api_id/api_hash از «تنظیمات پلتفرم» در CRM وارد می‌شوند (نه از env)؛
# نام کلیدهای platform_settings (مقادیر این‌جا همیشه خالی می‌مانند):
#   telegram.enabled            — فعال/غیرفعال بودن بات (true/false)
#   telegram.bot_token           — توکن بات (secret، رمزنگاری‌شده با ENCRYPTION_KEY)
#   telegram.webhook_secret      — رمز وبهوک (هدر X-Telegram-Bot-Api-Secret-Token)
#   telegram.channel             — کانال پیش‌فرض (مثلاً @madrasto_al_emamo_al_matoridi)
#   telegram.api_id / telegram.api_hash — برای اتصال حساب Telethon از CRM (secret)
#   telegram.session             — session رمزنگاری‌شدهٔ Telethon (خودکار، secret)
#   telegram.phone_masked        — شمارهٔ ماسک‌شده (فقط نمایشی)
